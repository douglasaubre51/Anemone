<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Anemone.Views.TaskDetails"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Anemone.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Anemone.Models"
    mc:Ignorable="d">
    <Grid Margin="16" RowSpacing="8">
        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            Spacing="4">
            <TextBlock
                FontSize="20"
                FontWeight="SemiBold"
                Text="{x:Bind ViewModel.CurrentProject.Title, Mode=OneWay}" />

            <ProgressRing
                Width="16"
                Height="16"
                VerticalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </StackPanel>

        <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.IsTaskListEmpty, Mode=OneWay}">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="32"
                Foreground="LightGray"
                Text="Tasks will be shown here" />
        </Grid>

        <ListView
            Grid.Row="1"
            Margin="0,16,0,0"
            CornerRadius="8"
            ItemsSource="{x:Bind ViewModel.AllTasks}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Task">
                    <Grid MinWidth="700" Background="White" Padding="16,2" CornerRadius="8" Margin="1">
                        <TextBlock
                            Grid.Column="0"
                            FontWeight="Medium"
                            VerticalAlignment="Center"
                            Text="{x:Bind Content}" />

                        <CommandBar Width="300" HorizontalAlignment="Right">
                            <AppBarButton
                                Click="OnMarkAsDoneBtnClicked"
                                Icon="Accept"
                                Label="Mark as Done" />

                            <AppBarButton
                                Click="OnMarkAsUnDoneBtnClicked"
                                Icon="Remove"
                                Label="Mark as UnDone" />

                            <AppBarButton
                                Click="OnDeleteTaskBtnClicked"
                                Icon="Delete"
                                Label="Remove Task" />
                        </CommandBar>

                        <ProgressBar
                            Grid.Column="1"
                            Width="200"
                            Background="{x:Bind StatusColor}" />

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </DataTemplate>

            </ListView.ItemTemplate>

            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
        </ListView>

        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="16">
            <TextBox
                Width="500"
                Height="40"
                Text="{x:Bind ViewModel.NewTaskContent, Mode=TwoWay}" />

            <Button
                Width="80"
                Height="40"
                Click="{x:Bind ViewModel.OnAddBtnClicked}"
                ClickMode="Press"
                Content="Add" />
        </StackPanel>

        <AppBarButton
            Grid.Row="3"
            Click="{x:Bind ViewModel.OnBackBtnClicked}"
            ClickMode="Press"
            Icon="Back"
            Label="Projects" />
        <ProgressRing Grid.Row="3" Visibility="{x:Bind ViewModel.IsBusy}" />

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
    </Grid>
</Page>
